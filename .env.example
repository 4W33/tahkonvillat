# Kopioi tama tiedosto nimella .env.local ja tayta arvot.
# .env.local on gitignoressa - ala koskaan committoi oikeita arvoja.

# Payload CMS - tietokanta. Paikallisesti: npm run db:dev (embedded Postgres).
# Tuotannossa Neon (Vercel Marketplace).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/tahkonvillat
# Generoi: openssl rand -hex 32
PAYLOAD_SECRET=

# Julkinen osoite (kaytetaan SEO:ssa ja sitemapissa)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob - Payloadin kuvat (Media). Tuotannossa pakollinen: JULKINEN (Public) Blob-säilö,
# Vercel lisää BLOB_READ_WRITE_TOKENin itse. Ilman tätä kehityksessä kuvat tallentuvat media/-kansioon.
BLOB_READ_WRITE_TOKEN=

# Resend - valinnainen. Ilman naita lomakkeet tallentuvat vain Payloadin Viestit-kokoelmaan.
# EMAIL_FROM vaatii Resendissa verifioidun domainin (esim. "Tahkon Villat <noreply@tahkonvillat.fi>").
# Ilman verifioitua domainia Resend toimittaa vain tilin omistajan osoitteeseen (onboarding@resend.dev).
RESEND_API_KEY=
EMAIL_FROM=
# Ilmoitusten vastaanottaja. Oletus: src/lib/site.config.ts contact.email.
EMAIL_TO=
