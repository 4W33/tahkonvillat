# Kopioi tama tiedosto nimella .env.local ja tayta arvot.
# .env.local on gitignoressa - ala koskaan committoi oikeita arvoja.

# Admin (/admin/login)
ADMIN_PASSWORD=
# Tuotannossa pakollinen ja EI saa olla "tahkon-villat-admin-session-2026".
# Generoi PowerShellissa:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object { [char]$_ })
ADMIN_SESSION_TOKEN=

# Julkinen osoite (kaytetaan SEO:ssa ja sitemapissa)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob - pakollinen tuotannossa, muuten admin-tallennukset kaatuvat.
# Ilman tata kehityksessa kirjoitetaan paikalliseen data/-kansioon.
BLOB_READ_WRITE_TOKEN=

# Resend - valinnainen. Ilman naita lomakkeet tallentuvat vain admin-inboxiin.
RESEND_API_KEY=
EMAIL_FROM=
