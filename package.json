{
  "name": "villasivut",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/clean-dev.mjs && next dev",
    "clean": "node scripts/clean-dev.mjs",
    "build": "node scripts/clean-cache.mjs && next build",
    "preview": "npm run build && next start",
    "start": "next start",
    "lint": "next lint",
    "scrape:airbnb": "node scripts/scrape-airbnb.mjs",
    "scrape:airbnb:browser": "node scripts/scrape-airbnb-browser.mjs",
    "content:sync": "node scripts/sync-airbnb-content.mjs",
    "content:messages": "node scripts/seed-site-messages.mjs",
    "content:prices": "node scripts/scrape-airbnb-prices.mjs",
    "content:import": "npm run scrape:airbnb:browser && npm run content:sync",
    "storage:seed": "node scripts/seed-blob-storage.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "next": "14.2.35",
    "next-intl": "^4.13.0",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
