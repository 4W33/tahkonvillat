{
  "name": "villasivut",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/clean-dev.mjs && next dev",
    "clean": "node scripts/clean-dev.mjs",
    "build": "node scripts/clean-cache.mjs && next build",
    "preview": "npm run build && next start",
    "start": "next start",
    "lint": "eslint .",
    "scrape:airbnb": "node scripts/scrape-airbnb.mjs",
    "scrape:airbnb:browser": "node scripts/scrape-airbnb-browser.mjs",
    "content:sync": "node scripts/sync-airbnb-content.mjs",
    "content:prices": "node scripts/scrape-airbnb-prices.mjs",
    "content:import": "npm run scrape:airbnb:browser && npm run content:sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev": "node scripts/dev-db.mjs",
    "payload": "payload",
    "cms:seed": "payload run scripts/seed-payload.ts",
    "cms:export-blob": "node scripts/export-blob-store.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.92.1",
    "@payloadcms/live-preview-react": "^3.92.1",
    "@payloadcms/next": "^3.92.1",
    "@payloadcms/storage-vercel-blob": "^3.92.1",
    "@payloadcms/translations": "^3.92.1",
    "@vercel/blob": "^2.4.0",
    "graphql": "^16.14.2",
    "ical.js": "^2.2.1",
    "next": "^16.4.3",
    "next-intl": "^4.13.0",
    "payload": "^3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.12.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
